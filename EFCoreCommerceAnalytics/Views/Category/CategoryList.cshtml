@model PagedList<Category>
@{
    ViewData["Title"] = "Kategoriler";
}
<div class="card">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-start mb-3">
            <div>
                <h4 class="card-title mb-1">Kategoriler</h4>
                <p class="text-muted small mb-0">@Model.TotalCount kategori</p>
            </div>
            <a asp-action="CreateCategory" class="btn btn-sm btn-primary"><i class="fas fa-plus mr-1"></i> Yeni kategori</a>
        </div>

        <input type="search" class="form-control mb-3" placeholder="Kategori adı ile ara…" aria-label="Kategori ara"
               value="@Model.Search" data-list-search="@Url.Action("CategoryList")" data-target="#categoryRows" />

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width:80px">#</th>
                        <th>Ad</th>
                        <th style="width:130px">Durum</th>
                        <th style="width:180px" class="text-right">İşlemler</th>
                    </tr>
                </thead>
                <tbody id="categoryRows">
                    <partial name="_CategoryRows" model="Model" />
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-end mt-3">
            <partial name="_Pagination" model='PagerModel.For(Model, "CategoryList")' />
        </div>
    </div>
</div>
