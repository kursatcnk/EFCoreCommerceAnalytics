@model Category
@{
    ViewData["Title"] = "CreateCategory";
    Layout = "~/Views/_Layout/Index.cshtml";
}

<div class="row">
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Kategori Ekle</h4>
                <p class="card-description">
                    
                </p>
                <form  method="post" class="forms-sample">
                    <div class="form-group">
                        <label for="exampleInputName1">Kategori Adı</label>
                        <input type="text" class="form-control" id="exampleInputName1"  required placeholder="Kategori Adı Giriniz" asp-for="CategoryName">
                    </div>
                    <button type="submit" class="btn btn-primary mr-2">Ekle</button>
                    <a href="/Category/CategoryList" class="btn btn-light">İptal</a>
                </form>
            </div>
        </div>
    </div>
</div>

