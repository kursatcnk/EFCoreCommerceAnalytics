@model Category
@{
    ViewData["Title"] = "UpdateCategory";
    Layout = "~/Views/_Layout/Index.cshtml";
}

<div class="row">
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Kategori Güncelleme</h4>
                <form method="post" class="forms-sample">
                    <input type="hidden" asp-for="CategoryId" />

                    <div class="form-group">
                        <label for="exampleInputName1">Kategori Adı</label>
                        <input type="text"
                               class="form-control"
                               id="exampleInputName1"
                               required
                               placeholder="Kategori Adı Giriniz"
                               asp-for="CategoryName" />
                    </div>

                    <!-- Düzgün Razor uyumlu dropdown -->
                    <div class="form-group">
                        <label for="Status">Kategori Durumu</label>
                        <select asp-for="Status" class="form-control">
                            <option value="true">Aktif</option>
                            <option value="false">Pasif</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary mr-2">Güncelle</button>
                    <a href="/Category/CategoryList" class="btn btn-light">İptal</a>
                </form>
            </div>
        </div>
    </div>
</div>
