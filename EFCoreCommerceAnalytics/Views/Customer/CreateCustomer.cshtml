@model EFCoreCommerceAnalytics.Entities.Customer
@{
    ViewData["Title"] = "CreateCustomer";
    Layout = "~/Views/_Layout/Index.cshtml";
}

<div class="row">
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Müşteri Ekle</h4>
                <form method="post" class="forms-sample">
                    <div class="form-group">
                        <label for="firstName">Ad</label>
                        <input type="text" class="form-control" id="firstName" placeholder="Müşteri Adı Giriniz" required asp-for="CustomerFirstName" />
                    </div>

                    <div class="form-group">
                        <label for="lastName">Soyad</label>
                        <input type="text" class="form-control" id="lastName" placeholder="Müşteri Soyadı Giriniz" required asp-for="CustomerLastName" />
                    </div>

                    <div class="form-group">
                        <label for="city">Şehir</label>
                        <input type="text" class="form-control" id="city" placeholder="Şehir Giriniz" required asp-for="CustomerCity" />
                    </div>

                    <div class="form-group">
                        <label for="district">İlçe</label>
                        <input type="text" class="form-control" id="district" placeholder="İlçe Giriniz" required asp-for="CustomerDistrict" />
                    </div>

                    <div class="form-group">
                        <label for="balance">Bakiye</label>
                        <input type="number" class="form-control" id="balance" placeholder="Bakiye Giriniz" required asp-for="CustomerBalance" step="0.01" />
                    </div>

                    <div class="form-group">
                        <label for="imageUrl">Resim URL</label>
                        <input type="text" class="form-control" id="imageUrl" placeholder="Resim URL Giriniz" asp-for="CustomerImageUrl" />
                    </div>

                    <button type="submit" class="btn btn-primary mr-2">Ekle</button>
                    <a href="/Customer/CustomerList" class="btn btn-light">İptal</a>
                </form>
            </div>
        </div>
    </div>
</div>
