@model PagedList<Customer>
@{
    ViewData["Title"] = "Müşteriler";
}
<div class="card">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-start mb-3">
            <div>
                <h4 class="card-title mb-1">Müşteriler</h4>
                <p class="text-muted small mb-0">@Model.TotalCount müşteri</p>
            </div>
            <a asp-action="CreateCustomer" class="btn btn-sm btn-primary"><i class="fas fa-plus mr-1"></i> Yeni müşteri</a>
        </div>

        <input type="search" class="form-control mb-3" placeholder="Ad, soyad ya da şehir ile ara…" aria-label="Müşteri ara"
               value="@Model.Search" data-list-search="@Url.Action("CustomerList")" data-target="#customerRows" />

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width:56px"></th>
                        <th>Ad soyad</th>
                        <th>Şehir / ilçe</th>
                        <th class="text-right">Bakiye</th>
                        <th style="width:180px" class="text-right">İşlemler</th>
                    </tr>
                </thead>
                <tbody id="customerRows">
                    <partial name="_CustomerRows" model="Model" />
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-end mt-3">
            <partial name="_Pagination" model='PagerModel.For(Model, "CustomerList")' />
        </div>
    </div>
</div>
