@model IReadOnlyList<TopCityCustomer>
@{
    ViewData["Title"] = "En çok sipariş alan şehirler";
}
<div class="card">
    <div class="card-body">
        <h4 class="card-title mb-1">En çok sipariş alan 3 şehir</h4>
        <p class="text-muted small">Her şehirde en çok sipariş veren müşteriyle birlikte. İptal edilen siparişler sayılmıyor.</p>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Şehir</th>
                        <th class="text-right">Toplam sipariş</th>
                        <th>En çok sipariş veren</th>
                        <th class="text-right">Siparişi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">Henüz sipariş yok.</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="font-weight-bold">@item.City</td>
                            <td class="text-right">@item.TotalOrders</td>
                            <td><a asp-action="UpdateCustomer" asp-route-id="@item.CustomerId">@item.CustomerName</a></td>
                            <td class="text-right">@item.CustomerOrderCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
