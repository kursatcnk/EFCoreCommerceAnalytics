@model List<dynamic>
@{
    ViewData["Title"] = "En Çok Sipariş Alan Şehirler ve Müşteriler";
    Layout = "~/Views/_Layout/Index.cshtml";
}
<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">En Çok Sipariş Alan 3 Şehir</h4>
                <p class="card-description">
                    <code>Her şehirdeki en çok sipariş veren müşteri listelenmiştir.</code>
                </p>

                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Şehir</th>
                                <th>Toplam Sipariş</th>
                                <th>Müşteri ID</th>
                                <th>Müşteri Adı</th>
                                <th>Sipariş Sayısı</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.City</td>
                                    <td>@item.TotalOrders</td>
                                    <td>@item.CustomerId</td>
                                    <td>@item.Name</td>
                                    <td>@item.OrdersCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
