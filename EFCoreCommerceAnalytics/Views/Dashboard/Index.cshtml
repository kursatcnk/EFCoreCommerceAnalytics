@{
    ViewData["Title"] = "Dashboard";
}
<div class="page-header">
    <h3 class="page-title">Dashboard</h3>
</div>

<div class="row grid-margin">
    <div class="col-12">
        @await Component.InvokeAsync("DashboardSummary")
    </div>
</div>

<div class="row">
    <div class="col-lg-6 grid-margin stretch-card">@await Component.InvokeAsync("OrderStatusChart")</div>
    <div class="col-lg-6 grid-margin stretch-card">@await Component.InvokeAsync("DailyOrdersChart", new { days = 30 })</div>
</div>

<div class="row">
    <div class="col-lg-4 grid-margin stretch-card">@await Component.InvokeAsync("CustomerCityChart", new { top = 8 })</div>
    <div class="col-lg-4 grid-margin stretch-card">@await Component.InvokeAsync("ActivityList")</div>
    <div class="col-lg-4 grid-margin stretch-card">@await Component.InvokeAsync("ToDoPriorityChart")</div>
</div>

<div class="row">
    <div class="col-12 grid-margin">@await Component.InvokeAsync("LatestMessages", new { take = 5 })</div>
</div>

<div class="row">
    <div class="col-lg-7 grid-margin stretch-card">@await Component.InvokeAsync("LatestOrders", new { take = 5 })</div>
    <div class="col-lg-5 grid-margin stretch-card">@await Component.InvokeAsync("LatestToDos", new { take = 5 })</div>
</div>
