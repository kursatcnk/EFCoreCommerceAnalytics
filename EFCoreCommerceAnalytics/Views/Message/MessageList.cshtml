@model PagedList<Message>
@{
    ViewData["Title"] = "Mesajlar";
}
<div class="card">
    <div class="card-body">
        <h4 class="card-title mb-1">Mesajlar</h4>
        <p class="text-muted small">@Model.TotalCount mesaj, en yeniden eskiye.</p>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width:56px"></th>
                        <th>Gönderen</th>
                        <th>Başlık</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">Mesaj yok.</td></tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr class="@(item.IsRead ? "" : "font-weight-bold")">
                            <td><partial name="_Avatar" model="@(new AvatarModel(item.SenderNameSurname, item.SenderImageUrl))" /></td>
                            <td>@item.SenderNameSurname</td>
                            <td><a asp-action="Detail" asp-route-id="@item.MessageId">@item.Title</a></td>
                            <td class="text-nowrap">@item.DateTime.ToString("dd.MM.yyyy HH:mm")</td>
                            <td><span class="badge badge-pill @(item.IsRead ? "badge-success" : "badge-warning")">@(item.IsRead ? "Okundu" : "Okunmadı")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-end mt-3">
            <partial name="_Pagination" model='PagerModel.For(Model, "MessageList")' />
        </div>
    </div>
</div>
