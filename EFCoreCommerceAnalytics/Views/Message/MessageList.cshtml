@model List<Message>
@{
    ViewData["Title"] = "MessageList";
    Layout = "~/Views/_Layout/Index.cshtml";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body">
                <h3 class="card-title fw-bold text-primary mb-3">
                    <i class="bi bi-envelope-paper"></i> Mesajlar
                </h3>
                <p class="card-description text-muted mb-4">
                    <code>Gelen mesajları buradan inceleyebilirsiniz</code>
                </p>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Başlık</th>
                                <th>Gönderen</th>
                                <th>Tarih</th>
                                <th>Okundu Mu?</th>
                                <th>Görsel</th>
                                <th>Aksiyon</th>
                                @* <th>Güncelle</th>  // güncelleme kaldırıldı *@
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.MessageId</td>
                                    <td class="fw-semibold">@item.Title</td>
                                    <td>@item.SenderNameSurname</td>
                                    <td>@item.DateTime.ToString("dd.MM.yyyy HH:mm")</td>

                                    <td>
                                        @if (item.IsRead)
                                        {
                                            <span class="badge rounded-pill bg-success">Okundu</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-warning text-dark">Okunmadı</span>
                                        }
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(item.SenderImageUrl))
                                        {
                                            <img src="@item.SenderImageUrl" alt="Gönderen Görseli"
                                                 class="rounded-circle shadow-sm"
                                                 style="width:55px;height:55px;object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Yok</span>
                                        }
                                    </td>

                                    <td>
                                        <a href="/Message/Detail/@item.MessageId"
                                           class="btn btn-gradient-primary btn-sm px-3">
                                            <i class="bi bi-eye"></i> Mesaj Detayı
                                        </a>
                                    </td>

                                    @* Güncelleme işlemi artık kullanılmıyor
                                    <td>
                                        <a href="/Message/UpdateMessage/@item.MessageId"
                                           class="btn btn-outline-success">Güncelle</a>
                                    </td>
                                    *@
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="d-flex justify-content-between mt-4">
                        <a href="/Message/CreateMessage"
                           class="btn btn-gradient-success btn-lg shadow-sm">
                            <i class="bi bi-plus-circle"></i> Yeni Mesaj
                        </a>

                        <nav aria-label="Sayfalama">
                            <ul class="pagination pagination-lg mb-0">
                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("MessageList", new { page = i })">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
