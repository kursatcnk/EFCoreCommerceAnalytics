@model List<Order>
@{
    ViewData["Title"] = "İptal Edilen Siparişler";
    Layout = "~/Views/_Layout/Index.cshtml";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">İptal Edilen Siparişler</h4>
                <p class="card-description">
                    <code>Bu sayfa yalnızca iptal edilmiş siparişlerin görüntülenmesi içindir.</code>
                </p>

                <!-- Arama inputu -->
                <input type="text" id="searchInput" class="form-control mb-3"
                       placeholder="Müşteri, ürün veya tarih ara..." />

                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Ürün</th>
                                <th>Müşteri</th>
                                <th>Adet</th>
                                <th>Birim Fiyat</th>
                                <th>Toplam</th>
                                <th>Tarih</th>
                                <th>Durum</th>
                            </tr>
                        </thead>
                        <tbody id="orderTableBody">
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.OrderId</td>
                                    <td>@item.Product?.ProductName</td>
                                    <td>@item.Customer?.CustomerFirstName @item.Customer?.CustomerLastName</td>
                                    <td>@item.OrderCount</td>
                                    <td>@item.UnitPrice.ToString("C")</td>
                                    <td>@item.TotalPrice.ToString("C")</td>
                                    <td>@item.OrderDate.ToString("dd.MM.yyyy")</td>
                                    <td>@item.SaleStatus</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-end mt-3">
                    <nav aria-label="Sayfalama">
                        <ul class="pagination mb-0">
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("CanceledOrders", new { page = i })">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>

            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(function () {
        let typingTimer;
        const doneTypingInterval = 300;

        $('#searchInput').on('keyup', function () {
            clearTimeout(typingTimer);
            const query = $(this).val();

            typingTimer = setTimeout(function () {
                $.ajax({
                    url: '/Order/CanceledOrders',
                    type: 'GET',
                    data: { search: query },
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (result) {
                        $('#orderTableBody').html(result);
                        if (query.length > 0) {
                            $('.pagination').hide();
                        } else {
                            $('.pagination').show();
                        }
                    }
                });
            }, doneTypingInterval);
        });
    });
</script>
