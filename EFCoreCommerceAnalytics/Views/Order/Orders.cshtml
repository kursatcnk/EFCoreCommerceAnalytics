@model PagedList<Order>
@{
    var action = (string)ViewData["ListAction"]!;
    var showActions = (bool)ViewData["ShowActions"]!;
}
<div class="card">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-start mb-3">
            <div>
                <h4 class="card-title mb-1">@ViewData["Title"]</h4>
                <p class="text-muted small mb-0">@Model.TotalCount sipariş</p>
            </div>
            <div class="btn-group btn-group-sm" role="group" aria-label="Sipariş listeleri">
                <a asp-action="OrderList" class="btn @(action == "OrderList" ? "btn-primary" : "btn-outline-primary")">Tümü</a>
                <a asp-action="ActiveOrders" class="btn @(action == "ActiveOrders" ? "btn-primary" : "btn-outline-primary")">En yeni</a>
                <a asp-action="CanceledOrders" class="btn @(action == "CanceledOrders" ? "btn-primary" : "btn-outline-primary")">İptal edilenler</a>
            </div>
        </div>

        <div class="d-flex mb-3">
            <input type="search" class="form-control" placeholder="Müşteri, ürün ya da durum ile ara…" aria-label="Sipariş ara"
                   value="@Model.Search" data-list-search="@Url.Action(action)" data-target="#orderRows" />
            @if (showActions)
            {
                <a asp-action="CreateOrder" class="btn btn-primary ml-2 text-nowrap"><i class="fas fa-plus mr-1"></i> Yeni sipariş</a>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Ürün</th>
                        <th>Müşteri</th>
                        <th class="text-right">Adet</th>
                        <th class="text-right">Birim fiyat</th>
                        <th class="text-right">Toplam</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        @if (showActions) { <th class="text-right">İşlemler</th> }
                    </tr>
                </thead>
                <tbody id="orderRows">
                    <partial name="_OrderRows" model="Model" />
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-end mt-3">
            <partial name="_Pagination" model="PagerModel.For(Model, action)" />
        </div>
    </div>
</div>
