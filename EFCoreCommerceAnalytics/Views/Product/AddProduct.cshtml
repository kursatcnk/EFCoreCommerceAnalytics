@model Product
@{
    ViewData["Title"] = "AddProduct";
    Layout = "~/Views/_Layout/Index.cshtml";
}

<div class="row">
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Ürün Ekle</h4>
                <p class="card-description">

                </p>
                <form method="post" class="forms-sample">
                    <div class="form-group">
                        <label for="exampleInputName1">Ürün Adı</label>
                        <input type="text" class="form-control" id="exampleInputName1" required placeholder="Ürün Adı Giriniz" asp-for="ProductName">
                    </div>
                    <div class="form-group">
                        <label for="exampleInputName1">Ürün Fiyatı</label>
                        <input type="text" class="form-control" id="exampleInputName1" required placeholder="Ürün Fiyatını Giriniz" asp-for="ProductPrice">
                    </div>
                    <div class="form-group">
                        <label for="exampleInputName1">Kategori</label>
                        <select asp-for="CategoryId" asp-items="@ViewBag.Categories" class="form-control" required>
                            <option value="">Kategori Seçiniz</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="exampleInputName1">Stok Sayısı</label>
                        <input type="text" class="form-control" id="exampleInputName1" required placeholder="Ürün Adı Giriniz" asp-for="ProductStock">
                    </div>

                    <button type="submit" class="btn btn-primary mr-2">Ekle</button>
                    <a href="/Product/ProductList" class="btn btn-light">İptal</a>
                </form>
            </div>
        </div>
    </div>
</div>

