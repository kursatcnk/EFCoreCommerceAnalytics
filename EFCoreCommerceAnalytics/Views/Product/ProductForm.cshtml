@model FormPage<ProductInput>
@{
    ViewData["Title"] = Model.IsEdit ? "Ürün düzenle" : "Ürün ekle";
    var action = Model.IsEdit ? "UpdateProduct" : "AddProduct";
}
<div class="row">
    <div class="col-lg-7 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">@ViewData["Title"]</h4>
                <form asp-action="@action" asp-route-id="@Model.Id" method="post" class="forms-sample" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                    <div class="form-group">
                        <label asp-for="Input.Name"></label>
                        <input asp-for="Input.Name" class="form-control" placeholder="Ör. Kablosuz kulaklık" />
                        <span asp-validation-for="Input.Name" class="text-danger small"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.CategoryId"></label>
                        <select asp-for="Input.CategoryId" asp-items="Model.Options" class="form-control">
                            <option value="0">Kategori seçin</option>
                        </select>
                        <span asp-validation-for="Input.CategoryId" class="text-danger small"></span>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-sm-6">
                            <label asp-for="Input.Price"></label>
                            <div class="input-group">
                                <input asp-for="Input.Price" type="number" step="0.01" min="0" class="form-control" value="@(Model.Input.Price == 0 ? "" : Model.Input.Price.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                                <div class="input-group-append"><span class="input-group-text">₺</span></div>
                            </div>
                            <span asp-validation-for="Input.Price" class="text-danger small"></span>
                        </div>
                        <div class="form-group col-sm-6">
                            <label asp-for="Input.Stock"></label>
                            <input asp-for="Input.Stock" type="number" min="0" step="1" class="form-control" />
                            <span asp-validation-for="Input.Stock" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary mr-2">@(Model.IsEdit ? "Kaydet" : "Ekle")</button>
                    <a asp-action="ProductList" class="btn btn-light">Vazgeç</a>
                </form>
            </div>
        </div>
    </div>
</div>
