@model PagedList<Product>
@{
    ViewData["Title"] = "Ürünler";
}
<div class="card">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-start mb-3">
            <div>
                <h4 class="card-title mb-1">Ürünler</h4>
                <p class="text-muted small mb-0">@Model.TotalCount ürün</p>
            </div>
            <a asp-action="AddProduct" class="btn btn-sm btn-primary"><i class="fas fa-plus mr-1"></i> Yeni ürün</a>
        </div>

        <input type="search" class="form-control mb-3" placeholder="Ürün ya da kategori adı ile ara…" aria-label="Ürün ara"
               value="@Model.Search" data-list-search="@Url.Action("ProductList")" data-target="#productRows" />

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width:70px">#</th>
                        <th>Ad</th>
                        <th>Kategori</th>
                        <th class="text-right">Fiyat</th>
                        <th class="text-right">Stok</th>
                        <th style="width:180px" class="text-right">İşlemler</th>
                    </tr>
                </thead>
                <tbody id="productRows">
                    <partial name="_ProductRows" model="Model" />
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-end mt-3">
            <partial name="_Pagination" model='PagerModel.For(Model, "ProductList")' />
        </div>
    </div>
</div>
