@model List<EFCoreCommerceAnalytics.Models.TodoStatusChartViewModel>
@using Newtonsoft.Json

@{
    var statusLabels = Model.Select(x => x.Status).ToList();
    var statusCounts = Model.Select(x => x.Count).ToList();
}

<div class="col-md-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body text-center">
            <h4 class="card-title">
                <i class="fas fa-tasks"></i> Yapılacaklar - Durum Dağılımı
            </h4>

            <!-- 🎯 Sabit boyut verildi -->
            <canvas id="todo-status-chart" style="width:400px; height:200px;"></canvas>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    window.addEventListener('DOMContentLoaded', () => {
        const labels = @Html.Raw(JsonConvert.SerializeObject(statusLabels));
        const counts = @Html.Raw(JsonConvert.SerializeObject(statusCounts));

        const ctx = document.getElementById('todo-status-chart').getContext('2d');
        new Chart(ctx, {
            type: 'pie',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Duruma Göre Yapılacaklar',
                    data: counts,
                    backgroundColor: [
                        'rgba(255, 99, 132, 0.6)',
                        'rgba(54, 162, 235, 0.6)',
                        'rgba(255, 206, 86, 0.6)',
                        'rgba(75, 192, 192, 0.6)',
                        'rgba(153, 102, 255, 0.6)'
                    ],
                    borderColor: '#fff',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: false,          // sabit piksel ölçüsünü kullan
                maintainAspectRatio: false, // en-boy oranını style'dan al
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            boxWidth: 15,
                            font: { size: 12 }
                        }
                    }
                }
            }
        });
    });
</script>
