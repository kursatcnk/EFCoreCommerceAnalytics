@model List<Message>

<div class="row">
    <div class="col-12 grid-margin">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">
                    <i class="fas fa-envelope"></i> Son Mesajlar
                </h4>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <tbody>
                            @if (Model?.Any() == true)
                            {
                                @foreach (var msg in Model)
                                {
                                    <tr class="@(msg.IsRead ? "" : "fw-bold")">
                                        <td class="py-1">
                                            @if (!string.IsNullOrEmpty(msg.SenderImageUrl))
                                            {
                                                <img src="@msg.SenderImageUrl" alt="profile" class="img-sm rounded-circle" />
                                            }
                                            else
                                            {
                                                <div class="img-sm rounded-circle bg-secondary text-white text-center">
                                                    @(string.IsNullOrWhiteSpace(msg.SenderNameSurname) ? "?" : msg.SenderNameSurname.Substring(0, 1))
                                                </div>
                                            }
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(msg.SenderNameSurname) ? "-" : msg.SenderNameSurname)</td>
                                        <td>@(string.IsNullOrWhiteSpace(msg.Title) ? "-" : msg.Title)</td>
                                        <td class="text-muted d-none d-md-table-cell">
                                            @(string.IsNullOrWhiteSpace(msg.Content) ? "-" : (msg.Content.Length > 50 ? msg.Content.Substring(0, 50) + "..." : msg.Content))
                                        </td>
                                        <td>@msg.DateTime.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>
                                            <span class="badge @(msg.IsRead ? "bg-success" : "bg-warning text-dark")">
                                                @(msg.IsRead ? "Okundu" : "Okunmadı")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted">
                                        Gösterilecek mesaj yok
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
