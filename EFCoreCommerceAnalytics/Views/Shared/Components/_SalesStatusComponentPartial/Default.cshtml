        'rgba(255, 215, 0, 0.6)','rgba(218, 112, 214, 0.6)','rgba(127, 255, 212, 0.6)',
        'rgba(0, 255, 127, 0.6)','rgba(255, 182, 193, 0.6)','rgba(30, 144, 255, 0.6)',
        'rgba(178, 34, 34, 0.6)','rgba(0, 255, 255, 0.6)','rgba(221, 160, 221, 0.6)',
        'rgba(189, 183, 107, 0.6)','rgba(255, 228, 181, 0.6)','rgba(72, 61, 139, 0.6)',
        'rgba(46, 139, 87, 0.6)','rgba(255, 105, 180, 0.6)','rgba(176, 224, 230, 0.6)',
        'rgba(0, 100, 0, 0.6)','rgba(186, 85, 211, 0.6)','rgba(95, 158, 160, 0.6)',
        'rgba(240, 230, 140, 0.6)','rgba(205, 133, 63, 0.6)','rgba(0, 0, 205, 0.6)',
