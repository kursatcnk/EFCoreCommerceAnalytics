<div class="main-panel">
    <div class="content-wrapper">

        <!-- İlk satır kartlar -->
        <div class="row">
            <!-- Toplam Ürün Kategori Sayısı -->
            <div class="col-md-4 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title mb-0">Toplam Ürün Kategori Sayısı</h4>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-inline-block pt-3">
                                <div class="d-md-flex">
                                    <h2 class="mb-0">@ViewBag.categoryCount</h2>
                                    <div class="d-flex align-items-center ml-md-2 mt-2 mt-md-0">
                                        <i class="far fa-clock text-muted"></i>
                                        <small class="ml-1 mb-0">
                                            @DateTime.Now.ToString(" 'Saat' HH:mm 'itibariyle günceldir'")
                                        </small>
                                    </div>
                                </div>
                                <small class="text-gray">
                                    @ViewBag.totalOrderCount Adet Siparişte Bu Kategorilerde Ürün Satılmıştır.
                                </small>
                            </div>
                            <div class="d-inline-block">
                                <i class="fas fa-chart-pie text-info icon-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Günlük Alınan Sipariş Sayısı -->
            <div class="col-md-4 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title mb-0">Günlük Alınan Sipariş Sayısı</h4>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-inline-block pt-3">
                                <div class="d-md-flex">
                                    <h2 class="mb-0">@ViewBag.todaysOrderCount</h2>
                                    <div class="d-flex align-items-center ml-md-2 mt-2 mt-md-0">
                                        <i class="far fa-clock text-muted"></i>
                                        <small class="ml-1 mb-0">
                                            @DateTime.Now.ToString(" 'Saat' HH:mm 'itibariyle günceldir.'")
                                        </small>
                                    </div>
                                </div>
                                <small class="text-gray">
                                    @ViewBag.totalProductCount Adet Ürün Arasından Bugün Satılan Ürünler
                                </small>
                            </div>
                            <div class="d-inline-block">
                                <i class="fas fa-shopping-cart text-danger icon-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- En Popüler Ürün -->
            <div class="col-md-4 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title mb-0">En Popüler Ürün</h4>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-inline-block pt-3">
                                <div class="d-md-flex">
                                    <h2 class="mb-0" style="font-size:1.9rem;">
                                        @ViewBag.mostPopularProduct
                                    </h2>
                                    <div class="d-flex align-items-center ml-md-2 mt-2 mt-md-0">
                                        <i class="far fa-clock text-muted"></i>
                                        <small class="ml-1 mb-0">
                                            @DateTime.Now.ToString(" 'Saat' HH:mm 'itibariyle günceldir.'")
                                        </small>
                                    </div>
                                </div>
                                <small class="text-gray">
                                    Bu ürün @ViewBag.mostPopularProductTotalOrders Kez Satın Alınmıştır!
                                </small>
                            </div>
                            <div class="d-inline-block">
                                <i class="fas fa-bell text-info icon-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- İkinci satır kartlar (kopya) -->
        <div class="row mt-4">
            <!-- Toplam Ürün Kategori Sayısı (Kopya) -->
            <div class="col-md-4 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title mb-0">Depoda Bulunan Ürün Sayısı</h4>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-inline-block pt-3">
                                <div class="d-md-flex">
                                    <h2 class="mb-0">@ViewBag.totalStockCount</h2>
                                    <div class="d-flex align-items-center ml-md-2 mt-2 mt-md-0">
                                        <i class="far fa-clock text-muted"></i>
                                        <small class="ml-1 mb-0">
                                            @DateTime.Now.ToString(" 'Saat' HH:mm 'itibariyle günceldir'")
                                        </small>
                                    </div>
                                </div>
                                <small class="text-gray">
                                    @ViewBag.totalStockUsedInOrders Adet Ürün Satışı gerçekleşmiştir.
                                </small>
                            </div>
                            <div class="d-inline-block">
                                <i class="fas fa-chart-pie text-info icon-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title mb-0">Bu Ürün Hızla Tükenmekte!</h4>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-inline-block pt-3">
                                <div class="d-md-flex">
                                    <h2 class="mb-0">@ViewBag.LowestStockProductName</h2>
                                    <div class="d-flex align-items-center ml-md-2 mt-2 mt-md-0">
                                        <i class="far fa-clock text-muted"></i>
                                        <small class="ml-1 mb-0">
                                            @DateTime.Now.ToString(" 'Saat' HH:mm 'itibariyle günceldir'")
                                        </small>
                                    </div>
                                </div>
                                <small class="text-gray">
                                    Sadece @ViewBag.lowestStockAmount Adet Ürün Kalmıştır!
                                </small>
                            </div>
                            <div class="d-inline-block">
                                <i class="fas fa-chart-pie text-info icon-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title mb-0">Stokta En Çok Bulunan Ürün</h4>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-inline-block pt-3">
                                <div class="d-md-flex">
                                    <h2 class="mb-0">@ViewBag.HighestStockProductName</h2>
                                    <div class="d-flex align-items-center ml-md-2 mt-2 mt-md-0">
                                        <i class="far fa-clock text-muted"></i>
                                        <small class="ml-1 mb-0">
                                            @DateTime.Now.ToString(" 'Saat' HH:mm 'itibariyle günceldir'")
                                        </small>
                                    </div>
                                </div>
                                <small class="text-gray">
                                    @ViewBag.HighestStockAmount Adet Ürün Bulunmaktadır.
                                </small>
                            </div>
                            <div class="d-inline-block">
                                <i class="fas fa-chart-pie text-info icon-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title mb-0">5000 TL Altı Bütçe Dostu Ürünler</h4>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-inline-block pt-3">
                                <div class="d-md-flex">
                                    <h2 class="mb-0">@ViewBag.ProductsBelow5000Count</h2>
                                    <div class="d-flex align-items-center ml-md-2 mt-2 mt-md-0">
                                        <i class="far fa-clock text-muted"></i>
                                        <small class="ml-1 mb-0">
                                            @DateTime.Now.ToString(" 'Saat' HH:mm 'itibariyle günceldir'")
                                        </small>
                                    </div>
                                </div>
                                <small class="text-gray">
                                    Adet Ürün 5000 TL Altında Fiyata Sahiptir.
                                </small>
                            </div>
                            <div class="d-inline-block">
                                <i class="fas fa-chart-pie text-info icon-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Günlük Alınan Sipariş Sayısı (Kopya) -->
            <div class="col-md-4 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title mb-0">Ortalama Ürün Maliyeti</h4>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-inline-block pt-3">
                                <div class="d-md-flex">
                                    
                                    <h2 class="mb-0" style="font-size:2.5rem;">
                                        @Math.Round(ViewBag.averageProductPrice) TL
                                    </h2>
                                    <div class="d-flex align-items-center ml-md-2 mt-2 mt-md-0">
                                        <i class="far fa-clock text-muted"></i>
                                        <small class="ml-1 mb-0">
                                            
                                        </small>
                                    </div>
                                </div>
                                <small class="text-gray">

                                </small>
                            </div>
                            <div class="d-inline-block">
                                <i class="fas fa-shopping-cart text-danger icon-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- En Popüler Ürün (Kopya) -->
            <div class="col-md-4 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title mb-0">En Çok Kazandıran Kategori</h4>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-inline-block pt-3">
                                <div class="d-md-flex">
                                    <h2 class="mb-0" style="font-size:1.9rem;">
                                        @ViewBag.topRevenueCategory
                                    </h2>
                                    <div class="d-flex align-items-center ml-md-2 mt-2 mt-md-0">
                                        <i class="far fa-clock text-muted"></i>
                                        <small class="ml-1 mb-0">
                                            @DateTime.Now.ToString(" 'Saat' HH:mm 'itibariyle günceldir.'")
                                        </small>
                                    </div>
                                </div>
                                <small class="text-gray">
                                    Bu kateoride @ViewBag.TopRevenueCategoryOrders Adet Sipariş Gerçekleşmiştir!
                                </small>
                            </div>
                            <div class="d-inline-block">
                                <i class="fas fa-bell text-info icon-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <footer class="footer">
        <div class="d-sm-flex justify-content-center justify-content-sm-between">
            <span class="text-muted text-center text-sm-left d-block d-sm-inline-block">
                Copyright © 2018
                <a href="https://www.urbanui.com/" target="_blank">Urbanui</a>.
                All rights reserved.
            </span>
            <span class="float-none float-sm-right d-block mt-1 mt-sm-0 text-center">
                Hand-crafted &amp; made with <i class="far fa-heart text-danger"></i>
            </span>
        </div>
    </footer>
</div>
