@model List<ToDo>
<div class="col-md-7 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">
                <i class="fas fa-thumbtack"></i>
                Yapılacaklar
            </h4>
            <div class="add-items d-flex">
                <input type="text" class="form-control todo-list-input" placeholder="Yapılacak Listesinde Arama Yap">
                <button class="add btn btn-primary font-weight-bold todo-list-add-btn" id="add-task">Ekle</button>
            </div>
            <div class="list-wrapper">
                <ul class="d-flex flex-column-reverse todo-list">
                    @foreach (var item in Model)
                    {
                        <li class="@EFCoreCommerceAnalytics.Helpers.ToDoHelper.GetLiClass(item.ToDoStatus)">
                            <div class="form-check">
                                <label class="form-check-label">
                                    <input class="checkbox" type="checkbox" @EFCoreCommerceAnalytics.Helpers.ToDoHelper.GetCheckboxChecked(item.ToDoStatus)>
                                    @item.ToDoDescription
                                </label>
                            </div>
                            <i class="remove fa fa-times-circle"></i>
                        </li>
                    }

                </ul>
            </div>
        </div>
    </div>
</div>