@model ErrorViewModel
@{
    ViewData["Title"] = "Bir hata oluştu";
}
<div class="card">
    <div class="card-body text-center py-5">
        <i class="fas fa-exclamation-triangle text-danger icon-lg mb-3"></i>
        <h3>Bir şeyler ters gitti</h3>
        <p class="text-muted">İsteğiniz işlenirken beklenmeyen bir hata oluştu. Lütfen biraz sonra tekrar deneyin.</p>
        @if (Model.ShowRequestId)
        {
            <p class="small text-muted">Hata kodu: <code>@Model.RequestId</code></p>
        }
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary mt-2">Dashboard'a dön</a>
    </div>
</div>
