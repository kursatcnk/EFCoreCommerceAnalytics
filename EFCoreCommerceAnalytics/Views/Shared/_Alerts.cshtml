@using EFCoreCommerceAnalytics.Controllers
@* İşlem sonrası tek seferlik bildirim (TempData). Örn. "Kategori silindi." ya da "Bu kategoride ürün var". *@
@if (TempData[AppController.SuccessKey] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="status">
        @success
        <button type="button" class="close" data-dismiss="alert" aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
    </div>
}
@if (TempData[AppController.ErrorKey] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="close" data-dismiss="alert" aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
    </div>
}
