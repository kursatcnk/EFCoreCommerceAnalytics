@model EFCoreCommerceAnalytics.Entities.ToDo
@{
    ViewData["Title"] = "Yeni Görev Ekle";
    Layout = "~/Views/_Layout/Index.cshtml";
}

<div class="row">
    <div class="col-lg-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Yeni Görev Ekle</h4>

                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-success">@ViewBag.Message</div>
                }

                <form asp-action="CreateSingleTodo" method="post">
                    <div class="form-group">
                        <label>Açıklama</label>
                        <input asp-for="ToDoDescription" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label>Durum</label>
                        <select asp-for="ToDoStatus" class="form-control">
                            <option value="false">Tamamlanmadı</option>
                            <option value="true">Tamamlandı</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Öncelik</label>
                        <select asp-for="Priority" class="form-control">
                            <option value="Birincil">Birincil</option>
                            <option value="İkincil">İkincil</option>
                            <option value="Üçüncül">Üçüncül</option>
                            <option value="Dördüncül">Dördüncül</option>
                            <option value="Beşincil">Beşincil</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary mt-3">Görev Ekle</button>
                </form>
            </div>
        </div>
    </div>
</div>
