@model List<EFCoreCommerceAnalytics.Entities.ToDo>
@{
    ViewData["Title"] = "Dördüncül ve Beşincil Görevler";
    Layout = "~/Views/_Layout/Index.cshtml";
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Dördüncül ve Beşincil Öncelikli Görevler</h4>
                <p class="card-description">
                    <code>Toplam Görev Sayısı: @ViewBag.TotalCount</code>
                </p>

                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Açıklama</th>
                                <th>Durum</th>
                                <th>Öncelik</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.TodoId</td>
                                    <td>@item.ToDoDescription</td>
                                    <td>
                                        @if (item.ToDoStatus)
                                        {
                                            <span class="badge bg-success">Tamamlandı</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Tamamlanmadı</span>
                                        }
                                    </td>
                                    <td>@item.Priority</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <a href="/ToDo/CreateToDo" class="btn btn-outline-primary mt-3">Yeni Görev Ekle</a>
            </div>
        </div>
    </div>
</div>
