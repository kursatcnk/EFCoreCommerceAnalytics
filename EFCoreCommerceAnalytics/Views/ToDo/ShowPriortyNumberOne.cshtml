@model List<EFCoreCommerceAnalytics.Entities.ToDo>
@{
    ViewData["Title"] = "Birincil Görevler";
    Layout = "~/Views/_Layout/Index.cshtml";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Birincil Öncelikli Görevler</h4>
                <p class="card-description">
                    <code>Toplam Birincil Görev Sayısı: @ViewBag.BirincilCount</code>
                </p>

                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Açıklama</th>
                                <th>Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.TodoId</td>
                                    <td>@item.ToDoDescription</td>
                                    <td>
                                        @if (item.ToDoStatus)
                                        {
                                            <label class="badge badge-success badge-pill">Tamamlandı</label>
                                        }
                                        else
                                        {
                                            <label class="badge badge-danger badge-pill">Tamamlanmadı</label>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="mt-3">
                        <p><strong>Görev Açıklamaları (Aggregate ile birleştirilmiş):</strong></p>
                        <p>@ViewBag.AggregatedDescriptions</p>
                    </div>

                    <div class="d-flex justify-content-between mt-3">
                        <a href="/ToDo/CreateToDo" class="btn btn-outline-primary">Yeni Görev Ekle</a>

                        <nav aria-label="Sayfalama">
                            <ul class="pagination mb-0">
                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("ShowBirincil", new { page = i })">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
